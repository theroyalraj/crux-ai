# Crux HTTP API base (no trailing slash).
# Empty = use Vite dev proxy: same-origin /voice, /speak, /health → http://127.0.0.1:9090 (see vite.config.ts).
# Set to http://127.0.0.1:9090 if you want all API calls to hit Crux directly (no proxy).
VITE_CRUX_BASE=

# WebSocket origin for narration only: ws://host:port or wss://host:port (no path).
# Empty + empty VITE_CRUX_BASE → ws://127.0.0.1:9090 (avoids Vite WS proxy EPIPE / early close).
# Set when Crux runs on another host/port or behind TLS, e.g. wss://crux.example.com
VITE_CRUX_WS_ORIGIN=

# Must match server CRUX_VOICE_WS_SECRET when that env is set (query ?secret= and X-Crux-Voice-Secret on downflow).
VITE_CRUX_VOICE_SECRET=
