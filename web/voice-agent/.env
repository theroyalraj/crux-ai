# Crux HTTP: empty = Vite proxy to 127.0.0.1:9090. Or set http://127.0.0.1:9090 for direct calls.
VITE_CRUX_BASE=

# Narration WebSocket: empty defaults to ws://127.0.0.1:9090 (bypasses Vite WS proxy).
VITE_CRUX_WS_ORIGIN=

# Must match server CRUX_VOICE_WS_SECRET when set.
VITE_CRUX_VOICE_SECRET=test

# Server-only (root repo .env), not read by Vite: CRUX_ELEVENLABS_AGENT_ID, CRUX_VOICE_OUTPUT, CRUX_CORS_ORIGINS.
