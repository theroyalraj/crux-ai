# Master
CRUX_ENABLED=true

# Features
CRUX_TTS_ENABLED=true
CRUX_AMBIENT_ENABLED=false
CRUX_REVIEWER_ENABLED=true
CRUX_COMMITTER_ENABLED=true
CRUX_WATCHER_ENABLED=true
CRUX_NARRATOR_ENABLED=true
CRUX_SEMANTIC_CACHE_ENABLED=true
CRUX_EXACT_CACHE_ENABLED=true

# Server (bind loopback unless you intend LAN exposure)
CRUX_HOST=127.0.0.1
CRUX_PORT=9090
CRUX_LOG_LEVEL=info
# Required for POST /internal/hourly-decision (X-Crux-Secret)
CRUX_INTERNAL_SECRET=

# LLM
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=qwen/qwen3-coder:free
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CRUX_LLM_PROVIDER=openrouter

# TTS — see `server/tts/data/tts_registry.json` (locales, personas, provider chain)
# Optional overlay JSON merged on top (add Hindi locale, new personas, etc.)
CRUX_TTS_CONFIG_PATH=
# auto | say | edge (must appear in locale chain)
CRUX_TTS_PROVIDER=
# Set false to drop Edge from the chain (macOS can use say-only from JSON)
CRUX_EDGE_TTS_ENABLED=true
CRUX_SAY_RATE_WPM=200
CRUX_SAY_PATH=
CRUX_SAY_VOICE_DEFAULT=Samantha
CRUX_SAY_VOICE_BLOCK=

# Edge pool (when CRUX_EDGE_TTS_ENABLED=true)
CRUX_TTS_VOICE=en-US-JennyNeural
CRUX_TTS_RATE=+7%
CRUX_TTS_PITCH=+2Hz
CRUX_TTS_VOICE_BLOCK=
CRUX_TTS_LOCK_TTL_SEC=600
CRUX_TTS_STREAM=true
# none | notify
CRUX_TTS_FALLBACK=none
# If ffplay is not on PATH: /opt/homebrew/bin/ffplay
CRUX_FFPLAY_PATH=

# Persona overrides (empty = use registry default)
CRUX_FORGE_VOICE=
CRUX_FORGE_RATE=
CRUX_SENTINEL_VOICE=
CRUX_SENTINEL_RATE=
CRUX_CHRONICLE_VOICE=
CRUX_CHRONICLE_RATE=
CRUX_SAGE_VOICE=
CRUX_SAGE_RATE=
CRUX_MAESTRO_VOICE=
CRUX_MAESTRO_RATE=
CRUX_ECHO_VOICE=
CRUX_ECHO_RATE=

# macOS `say -v` overrides (when CRUX_EDGE_TTS_ENABLED=false); list voices: say -v '?'
CRUX_FORGE_SAY_VOICE=
CRUX_SENTINEL_SAY_VOICE=
CRUX_CHRONICLE_SAY_VOICE=
CRUX_SAGE_SAY_VOICE=
CRUX_MAESTRO_SAY_VOICE=
CRUX_ECHO_SAY_VOICE=

# Infra
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgresql://crux:crux@127.0.0.1:5433/crux
EMBEDDING_DIM=1536

# Cache
CACHE_TTL_SEC=3600
CACHE_SEMANTIC_THRESHOLD=0.95
CACHE_SEMANTIC_MAX_AGE_DAYS=7
CACHE_EMBED_TTL_SEC=300

# Git (absolute path recommended for repos Crux manages)
CRUX_GIT_AUTO_COMMIT=true
CRUX_GIT_COMMIT_INTERVAL_MIN=60
CRUX_GIT_AUTO_MR=true
CRUX_GIT_TARGET_BRANCH=
CRUX_GIT_REPO_PATH=.

# Hourly confirmation
CRUX_HOURLY_CONFIRM_TIMEOUT_SEC=600
CRUX_HOURLY_REBASE_ON_TIMEOUT=false

# Optional STT
CRUX_LISTEN_ENABLED=false
CRUX_WHISPER_MODEL=small

# Ambient nudges
CRUX_AMBIENT_INTERVAL_SEC=1800

CRUX_USER_NAME=Developer
CRUX_USER_TZ=UTC

# Reviewer poll interval (minutes)
CRUX_REVIEWER_INTERVAL_MIN=15
CRUX_WATCHER_DEBOUNCE_SEC=5
# Set true only if you want Echo TTS on file changes (competes with manual /speak generation).
CRUX_WATCHER_SPEAK_ENABLED=false

# ElevenLabs (optional). With API key: TTS tries ElevenLabs first, then macOS say, then Edge.
# Get a key: ElevenLabs site, sign up, Profile or API keys, create key with text-to-speech scope.
CRUX_ELEVENLABS_ENABLED=true
CRUX_ELEVENLABS_API_KEY=sk_70bf37e9630fb02384ff25071c0e55d54cace571c7df95aa
CRUX_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# basic | medium | best (flash, turbo, multilingual v2 — see server/tts/eleven_models.py)
CRUX_ELEVENLABS_MODEL_TIER=basic
CRUX_ELEVENLABS_VOICE_ID=
CRUX_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
CRUX_ELEVENLABS_VOICE_BLOCK=
CRUX_ELEVENLABS_TIMEOUT_SEC=120
# Redis cache TTL for ElevenLabs MP3 (startup clears all keys in this namespace)
CRUX_TTS_ELEVEN_CACHE_TTL_SEC=3600
